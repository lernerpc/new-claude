<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_partner_form_sport" model="ir.ui.view">
        <field name="name">res.partner.form.sport</field>
        <field name="model">res.partner</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="is_student" invisible="1"/>
                <field name="is_coach" invisible="1"/>
                <field name="is_sport" invisible="1"/>
            </xpath>

            <!-- Insert schedule summary directly under the student name, using only 'invisible' modifier -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="schedule_summary" readonly="1" nolabel="1" widget="html" invisible="not is_student"/>
            </xpath>

            <field name="vat" position="attributes">
                <attribute name="invisible">not is_sport</attribute>
            </field>
            <field name="title" position="attributes">
                <attribute name="invisible">not is_sport</attribute>
            </field>
            <field name="category_id" position="attributes">
                <attribute name="invisible">not is_sport</attribute>
            </field>

            <xpath expr="//span[@name='address_name']" position="before">
                <field name="p_name" invisible="not is_student"/>
                <field name="short_name" invisible="not is_sport"/>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="invisible">is_student or is_coach</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">is_student or is_coach</attribute>
            </xpath>

            <xpath expr="//sheet" position="before">
                <button name="action_open_student_id_print_wizard" type="object" string="Print Student ID" class="oe_highlight" invisible="not is_student"/>
            </xpath>
        </field>
    </record>
    
    <!-- Tree view for students with schedule information -->
    <record id="view_res_partner_tree_student_schedules" model="ir.ui.view">
        <field name="name">res.partner.tree.student.schedules</field>
        <field name="model">res.partner</field>
        <field name="type">tree</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="is_student" invisible="1"/>
                <field name="enrolled_sports" invisible="not is_student"/>
                <field name="selected_schedules" invisible="not is_student"/>
                <field name="sports_count" invisible="not is_student"/>
                <field name="schedules_count" invisible="not is_student"/>
            </xpath>
        </field>
    </record>
    
    <!-- Search view for students with schedule filters -->
    <record id="view_res_partner_search_student_schedules" model="ir.ui.view">
        <field name="name">res.partner.search.student.schedules</field>
        <field name="model">res.partner</field>
        <field name="type">search</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="enrolled_sports"/>
                <field name="sport_id"/>
                <group expand="0" string="Group By">
                    <filter string="Enrolled Sports" name="group_sports" context="{'group_by': 'enrolled_sports'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>