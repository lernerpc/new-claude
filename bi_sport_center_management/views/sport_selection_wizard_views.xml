<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sport Selection Wizard -->
        <record id="view_sport_selection_wizard_form" model="ir.ui.view">
            <field name="name">sport.selection.wizard.form</field>
            <field name="model">sport.selection.wizard</field>
            <field name="arch" type="xml">
                <form string="اختر رياضة للفلترة">
                    <sheet>
                        <h2 class="text-center mb-3">
                            <i class="fa fa-trophy me-2"></i>اختر رياضة للفلترة
                        </h2>
                        
                        <group>
                            <field name="sport_id" widget="radio" nolabel="1"/>
                        </group>
                        
                        <footer>
                            <button name="select_sport" type="object" string="تطبيق الفلتر" class="btn-primary"/>
                            <button string="إلغاء" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
