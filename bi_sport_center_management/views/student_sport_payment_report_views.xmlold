<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_sport_payment_report_tree" model="ir.ui.view">
        <field name="name">student.sport.payment.report.tree</field>
        <field name="model">student.sport.payment.report</field>
        <field name="arch" type="xml">
            <tree string="Student Sport Payment Report" export="1">
                <field name="activity_id"/>
                <field name="student_id"/>
                <field name="membership_number"/>
                <field name="invoice_id"/>
                <field name="receipt_number"/>
                <field name="membership_month"/>
                <field name="payment_state"/>
            </tree>
        </field>
    </record>

    <record id="action_student_sport_payment_report" model="ir.actions.act_window">
        <field name="name">Student Sport Payment Report</field>
        <field name="res_model">student.sport.payment.report</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_student_sport_payment_report_tree"/>
        <field name="context">{}</field>
        <field name="search_view_id" eval="False"/>
    </record>

    <menuitem id="menu_student_sport_payment_report" name="Student Sport Payment Report"
        parent="bi_sport_center_management.menu_bi_sport_center_management_root"
        action="action_student_sport_payment_report" sequence="100"/>
</odoo> 